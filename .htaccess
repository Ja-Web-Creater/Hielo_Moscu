# =========================================================================
# REGLAS DE SEGURIDAD DE SERVIDOR APACHE - HIELO MOSCÚ
# =========================================================================

# 1. Evitar que cualquiera pueda ver el listado de archivos de tus carpetas
Options -Indexes

# 2. Proteger archivos sensibles o de configuración contra descarga directa
<FilesMatch "^(\.htaccess|\.git|seguridad\.php|conexion\.php|config\.php)">
    Require all denied
</FilesMatch>

# 3. Bloquear firmas de servidor
ServerSignature Off

# 4. Cabeceras de seguridad y control de headers (protegidas por IfModule)

<IfModule mod_headers.c>
    # Evita ataques de Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Previene la interpretación incorrecta de tipos MIME (MIME-sniffing)
    Header always set X-Content-Type-Options "nosniff"
    
    # Protección básica contra XSS en navegadores antiguos
    Header always set X-XSS-Protection "1; mode=block"
    
    # Ocultar tecnología de PHP
    Header unset X-Powered-By
</IfModule>