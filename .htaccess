# =========================================================================
# REGLAS DE SEGURIDAD DE SERVIDOR APACHE - HIELO MOSCÚ
# =========================================================================

# 1. Evitar listado de directorios
Options -Indexes

# 2. Proteger archivos sensibles
<FilesMatch "^(\.htaccess|\.git|seguridad\.php|conexion\.php|config\.php)">
    Require all denied
</FilesMatch>

# 3. Ocultar firma de servidor
ServerSignature Off

# 4. Cabeceras de seguridad unificadas (Evita duplicados)
<IfModule mod_headers.c>
    # Remover cabeceras que revelan tecnología o se duplican
    Header unset X-Powered-By
    Header always unset X-Frame-Options

    # Aplicar cabeceras de forma limpia y única
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>